# Environment
NODE_ENV=development
PORT=5000

# Database
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-url>/<database-name>

# Frontend
FRONTEND_URL=http://localhost:5173

# GitHub OAuth
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:5000/api/auth/github/callback

# JWT Secrets
JWT_ACCESS_SECRET=your_generated_access_key
JWT_REFRESH_SECRET=another_different_generated_key

# Encryption
ENCRYPTION_KEY=your_32_character_encryption_key

# Redis
REDIS_URL=redis://localhost:6379

# Max concurrent jobs per worker
COMMIT_QUEUE_CONCURRENCY=5
TWEET_QUEUE_CONCURRENCY=5

# Webhook
WEBHOOK_BASE_URL=http://localhost:5000

# Gemini API
GEMINI_API_KEY=your_api_key_here